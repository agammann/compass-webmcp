/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

/*.md
  Content-Type: text/markdown; charset=utf-8

/.well-known/ard.json
  Content-Type: application/ai-catalog+json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/ai-catalog.json
  Content-Type: application/ai-catalog+json; charset=utf-8
  Access-Control-Allow-Origin: *
